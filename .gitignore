# Dependencies
node_modules/
.pnpm-store/

# Expo / React Native
.expo/
dist/
web-build/
expo-env.d.ts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Native projects are generated by `expo prebuild` / `expo run:android`
# (Continuous Native Generation), so they are build output, not source.
apps/*/android/
apps/*/ios/

# Build / tooling output
.turbo/
coverage/
*.tsbuildinfo
.metro-health-check*

# Visual comparison output (the design screenshots themselves live in design/)
apps/*/visual/actual/
apps/*/visual/diff/

# Environment and secrets: only EXPO_PUBLIC_ values may ever reach the app
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
